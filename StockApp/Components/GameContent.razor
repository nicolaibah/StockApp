@using ApexCharts
@using MudBlazor
@using StockApp.Models
@using StockApp.Services
@using StockLib

<style>
    /* Prevent white space at the bottom and add hover effect for scoreboard */
    .scoreboard-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .scoreboard-row:hover {
            background-color: var(--surface-container-high) !important;
            opacity: 0.9;
        }

    .btn-xs {
        padding: 2px 8px;
        font-size: 0.75rem;
    }
</style>

<div class="surface py-8 px-8" style="min-height: 100vh; display: flex; flex-direction: column;">
    <div class="breathing-lg">
        <div class="mb-12">
            <h1 class="display-md mb-4">Scoreboard</h1>
            <p class="body-md text-primary">Oversigt over alle spilleres porteføljer - Klik på en spiller for at se deres beholdning</p>
        </div>

        <div class="card mb-12">
            <div style="overflow-x: auto;">
                <table class="design-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Spiller</th>
                            <th>Total Værdi</th>
                            <th>Kontantbeholdning</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rankedPlayers = GetPlayersByTotalValue();
                            int rank = 1;
                            foreach (var player in rankedPlayers)
                            {
                                var isCurrent = player.Email == Email;
                                var isSelected = player.Email == DisplayPlayer.Email;
                                var totalValue = GetPlayerTotalValue(player);

                                <tr class="scoreboard-row @(isSelected ? "surface-container-highest" : (isCurrent ? "surface-container-high" : "surface-container-lowest"))"
                                    @onclick="() => SelectPlayer(player)">
                                    <td class="data-cell">@rank</td>
                                    <td>
                                        <div class="flex-center gap-4" style="justify-content: flex-start;">
                                            <span style="@(isSelected ? "font-weight: bold; color: var(--primary);" : "")">@player.Name</span>
                                            @if (isCurrent)
                                            {
                                                <span class="label-md" style="background-color: var(--primary-fixed); color: var(--on-primary); padding: 0.25rem 0.75rem; border-radius: var(--radius-md);">Dig</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="data-cell text-secondary">
                                        @($"{totalValue:N2} kr")
                                        @{
                                            // Optional: Show if the player is overall in profit or loss
                                            var initial = player.Stocks.Sum(s => s.GetValueInvested()) + (decimal)player.Capital;
                                            var totalGain = totalValue - initial;
                                            var gainColor = totalGain >= 0 ? "#7dffa2" : "#ffb4ab";
                                        }
                                        <div style="font-size: 0.7rem; color: @gainColor">
                                            @(totalGain >= 0 ? "+" : "")@totalGain.ToString("N2") kr
                                        </div>
                                    </td>
                                    <td class="data-cell">@($"{player.Capital:N2} kr")</td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (HasLoaded)
        {
            <div style="display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap;">

                <div class="card" style="flex: 2; min-width: 600px; position: relative; z-index: 1;">
                    <h2 class="headline-md mb-8">Portefølje Værdi Over Tid</h2>

                    <div class="flex gap-4 mb-8" style="flex-wrap: wrap;">
                        <button class="@GetTimeRangeButtonClass(TimeRange.OneDay)" @onclick="@(async () => await SwitchTimeRange(TimeRange.OneDay))">1 dag</button>
                        <button class="@GetTimeRangeButtonClass(TimeRange.FiveDays)" @onclick="@(async () => await SwitchTimeRange(TimeRange.FiveDays))">5 dage</button>
                        <button class="@GetTimeRangeButtonClass(TimeRange.OneMonth)" @onclick="@(async () => await SwitchTimeRange(TimeRange.OneMonth))">1 måned</button>
                        <button class="@GetTimeRangeButtonClass(TimeRange.ThreeMonths)" @onclick="@(async () => await SwitchTimeRange(TimeRange.ThreeMonths))">3 måneder</button>
                        @* <button class="@GetTimeRangeButtonClass("1y")" @onclick="@(async () => await SwitchTimeRange(TimeRange.on))">1 år</button> *@
                    </div>

                    <div style="height: 500px; position: relative;">
                        @if (Players.Any(p => p.PortfolioDateValues?.Any() == true))
                        {
                            <ApexChart @ref="_chart" TItem="ValuePoint" Options="chartOptions" Height="500">
                                @foreach (var player in Players.OrderByDescending(p => p.Email == Email))
                                {
                                    @if (true)
                                    {
                                        <ApexPointSeries TItem="ValuePoint"
                                                         Items="player.PortfolioDateValues"
                                                         Name="@(player.Email == Email ? "Dig (Portefølje)" : player.Name)"
                                                         SeriesType="SeriesType.Area"
                                                         XValue="@(e => e.Date)"
                                                         YValue="@(e => e.Value)" />
                                    }
                                }
                            </ApexChart>
                        }
                        else
                        {
                            <div style="text-align: center; padding: var(--spacing-8); color: rgba(214, 228, 249, 0.5); height: 100%; display: flex; align-items: center; justify-content: center;">
                                <p class="body-md">Ingen historik tilgængelig endnu</p>
                            </div>
                        }
                    </div>
                </div>

                <div style="flex: 1; min-width: 350px; display: flex; flex-direction: column; gap: 24px;">

                    <div class="card" style="position: relative; z-index: 2;">
                        <div class="flex-between mb-4">
                            <h2 class="headline-md">@(DisplayPlayer.Email == Email ? "Din Beholdning" : $"{DisplayPlayer.Name}s Beholdning")</h2>

                            @if (DisplayPlayer.Email == Email)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="async () => await AddTransaction()" style="background-color: var(--secondary); color: var(--on-secondary);">+ Tilføj</button>
                            }
                        </div>

                        @if (DisplayPlayer.Email != Email)
                        {
                            <div class="mb-6">
                                <button class="btn btn-tertiary btn-xs" @onclick="BackToMyHoldings" style="color: var(--primary);">
                                    ← Gå tilbage til min beholdning
                                </button>
                            </div>
                        }

                        @if (DisplayPlayer?.Stocks?.Any() == true)
                        {
                            <div style="overflow-x: auto;">
                                <table class="design-table">
                                    <thead>
                                        <tr>
                                            <th>Ticker</th>
                                            <th>Antal</th>
                                            <th>Værdi</th>
                                            @if (DisplayPlayer.Email == Email)
                                            {
                                                <th style="text-align: right;">Handling</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stock in DisplayPlayer.Stocks)
                                        {
                                            <tr class="surface-container-lowest">
                                                <td class="data-cell">
                                                    <div class="flex-center gap-2" style="justify-content: flex-start;">
                                                        <img src="@GetImgLogo(stock.Ticker)" style="width: 20px; height: 20px; border-radius: 4px;" />
                                                        @stock.Ticker
                                                    </div>
                                                </td>
                                                <td class="data-cell">@stock.Amount.ToString("N2")</td>
                                                <td class="data-cell text-secondary">@($"{stock.ValueInTargetCurrency:N2}")</td>

                                                @if (DisplayPlayer.Email == Email)
                                                {
                                                    <td style="text-align: right;">
                                                        <button class="btn btn-tertiary" style="padding: 2px 8px;" @onclick="async () => await AddTransaction(stock)">Sælg</button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="body-sm" style="text-align: center; padding: var(--spacing-12) 0; color: rgba(214, 228, 249, 0.5);">
                                Ingen aktier fundet.
                            </p>
                        }
                    </div>

                    <div class="card">
                        <h2 class="headline-md mb-6">Top Movers</h2>
                        @if (DisplayPlayer?.Stocks?.Any() == true)
                        {
                            <div class="flex flex-col gap-4">
                                @* Sort by the absolute percentage gain (highest movement first) *@
                                @foreach (var stock in DisplayPlayer.Stocks.OrderByDescending(s => Math.Abs(s.GetPercentageGain())).Take(3))
                                {
                                    var pctGain = stock.GetPercentageGain();
                                    var isPositive = pctGain >= 0;
                                    var colorStyle = isPositive ? "color: #7dffa2;" : "color: #ffb4ab;";
                                    var prefix = isPositive ? "+" : "";

                                    <div class="surface-container-lowest p-4 flex-between" style="border-radius: var(--radius-md); border-left: 4px solid @(isPositive ? "#7dffa2" : "#ffb4ab");">
                                        <div class="flex-center gap-3">
                                            <img src="@GetImgLogo(stock.Ticker)" style="width: 24px; height: 24px; border-radius: 4px;" />
                                            <div>
                                                <div class="label-lg" style="font-weight: bold;">@stock.Ticker</div>
                                                <div class="body-xs text-secondary">@(isPositive ? "Stigende" : "Faldende") position</div>
                                            </div>
                                        </div>
                                        <div style="text-align: right;">
                                            <div class="label-md text-primary">@($"{stock.ValueInTargetCurrency:N2}") kr</div>
                                            <div class="body-xs" style="@colorStyle font-weight: bold;">
                                                @prefix@pctGain.ToString("N2")%
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="body-sm" style="color: rgba(214, 228, 249, 0.5);">Ingen data tilgængelig.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameViewModel Value { get; set; }
    [Parameter, EditorRequired] public string Email { get; set; }

    [Inject] private IGameService _gameService { get; set; }
    [Inject] private IDialogService _dialogService { get; set; }
    [Inject] private PresentationService _presentation { get; set; }

    private ApexChart<ValuePoint> _chart = new();
    private string targetCurrency = "DKK";
    private ApexChartOptions<ValuePoint> chartOptions = new();
    private List<ParticipantViewModel> Players = [];
    private ParticipantViewModel CurrentPlayer = new();
    private ParticipantViewModel DisplayPlayer = new(); // The user currently being viewed
    private bool HasLoaded;
    private TimeRange SelectedTimeRange = TimeRange.FiveDays;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void SelectPlayer(ParticipantViewModel player)
    {
        DisplayPlayer = player;
        StateHasChanged();
    }

    private void BackToMyHoldings()
    {
        DisplayPlayer = CurrentPlayer;
        StateHasChanged();
    }



    private void SetupChartOptions()
    {
        List<string> colors = new();
        string[] colorPalette = { "#bbc6e2", "#ffb4ab", "#a8dadc", "#f1d4b1", "#d7b8ff", "#ffccdd" };
        int colorIndex = 0;

        var sortedPlayers = Players.OrderByDescending(p => p.Email == Email).ToList();

        foreach (var player in sortedPlayers)
        {
            if (player.Email == Email) colors.Add("#7dffa2");
            else
            {
                colors.Add(colorPalette[colorIndex % colorPalette.Length]);
                colorIndex++;
            }
        }

        chartOptions = new ApexChartOptions<ValuePoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true },
                Background = "transparent",
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Colors = colors,
            Fill = new Fill
            {
                Type = FillType.Gradient,
                Gradient = new FillGradient { OpacityFrom = 0.5, OpacityTo = 0.0 }
            },
            Yaxis = new List<YAxis> {
                new YAxis {
                    ForceNiceScale = true,
                    DecimalsInFloat = 0,
                    Labels = new YAxisLabels {
                        Style = new AxisLabelStyle {
                            Colors = new List<string> { "rgba(214, 228, 249, 0.6)" },
                            FontSize = "12px"
                        },
                        Formatter = @"value => Math.round(value).toLocaleString('da-DK') + ' kr'"
                    }
                }
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = new List<string> { "rgba(214, 228, 249, 0.6)" } }
                }
            },
            Grid = new Grid
            {
                Padding = new Padding { Top = 10, Bottom = 100, Left = 20, Right = 20 },
                BorderColor = "rgba(68, 71, 76, 0.1)"
            },
            Legend = new Legend
            {
                Show = true,
                Position = LegendPosition.Bottom,
                FontSize = "14px",
                Labels = new LegendLabels { Colors = "rgba(214, 228, 249, 0.6)" }
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Style = new TooltipStyle { FontFamily = "Inter, sans-serif" }
            }
        };
    }
    private async Task SwitchTimeRange(TimeRange t)
    {
        SelectedTimeRange = t;

        await _presentation.SetTickerHistory(t);

        await AfterUpdate();
    }

    private async Task LoadData()
    {
        try
        {
            HasLoaded = false;
            Players = await _gameService.GetPlayers(Value.Id);
            var player = Players.FirstOrDefault(x => x.Email == Email);
            if (player == null) return;

            CurrentPlayer = player;

            // If viewing an opponent, try to update DisplayPlayer with fresh data from the list
            if (DisplayPlayer != null && !string.IsNullOrEmpty(DisplayPlayer.Email))
            {
                DisplayPlayer = Players.FirstOrDefault(p => p.Email == DisplayPlayer.Email) ?? CurrentPlayer;
            }
            else
            {
                DisplayPlayer = CurrentPlayer;
            }

            await _presentation.Init(Players, Value.StartCapital, SelectedTimeRange);

            await AfterUpdate();
            HasLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            HasLoaded = true;
        }
    }

    private async Task AddTransaction(StockViewModel? sellStock = null)
    {
        try
        {
            DialogParameters dialParams = new() { { "GameId", Value.Id }, { "Ticker", sellStock?.Ticker } };
            var dial = await _dialogService.ShowAsync<Dialogs.TransactionDialog>("Transaction", dialParams);
            var res = await dial.Result;
            if (!res.Canceled) await LoadData();
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }



    private async Task AfterUpdate()
    {
        SetupChartOptions();
        StateHasChanged();
        if (_chart is not null) await _chart.UpdateSeriesAsync();
    }

    private List<DateTime> GenerateDateRangeForTimespan(TimeRange t)
    {
        string timeRange = t.Value;
        int daysBack = timeRange switch { "1d" => 1, "5d" => 5, "1m" => 30, "3m" => 90, "1y" => 365, _ => 5 };
        return Enumerable.Range(0, daysBack + 1).Select(i => DateTime.Now.AddDays(-i)).OrderBy(d => d).ToList();
    }

    private string GetImgLogo(string ticker)
    {
        return $"https://img.logo.dev/ticker/{ticker}?token=pk_fpJo-h0JQ6Kd9_FH96Ixrw";
    }

    private string GetTimeRangeButtonClass(TimeRange t) => $"btn {(SelectedTimeRange == t ? "btn-primary" : "btn-tertiary")}";
    private List<ParticipantViewModel> GetPlayersByTotalValue() => Players.OrderByDescending(p => GetPlayerTotalValue(p)).ToList();
    private decimal GetPlayerTotalValue(ParticipantViewModel player) => (decimal)player.Capital + player.Stocks.Sum(s => (decimal)s.ValueInTargetCurrency);
}