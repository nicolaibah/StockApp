@using ApexCharts
@using MudBlazor
@using StockApp.Models
@using StockApp.Services

<div class="surface py-8 px-8">
    <div class="breathing-lg">
        <div class="mb-12">
            <h1 class="display-md mb-4">Scoreboard</h1>
            <p class="body-md text-primary">Oversigt over alle spilleres porteføljer</p>
        </div>

        <div class="card mb-12">
            <div style="overflow-x: auto;">
                <table class="design-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Spiller</th>
                            <th>Total Værdi</th>
                            <th>Kontantbeholdning</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rankedPlayers = GetPlayersByTotalValue();
                            int rank = 1;
                            foreach (var player in rankedPlayers)
                            {
                                var isCurrent = player.Email == Email;
                                var totalValue = GetPlayerTotalValue(player);
                                <tr class="@(isCurrent ? "surface-container-high" : "surface-container-lowest")">
                                    <td class="data-cell">@rank</td>
                                    <td>
                                        <div class="flex-center gap-4" style="justify-content: flex-start;">
                                            <span>@player.Name</span>
                                            @if (isCurrent)
                                            {
                                                <span class="label-md" style="background-color: var(--primary-fixed); color: var(--on-primary); padding: 0.25rem 0.75rem; border-radius: var(--radius-md);">Dig</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="data-cell text-secondary">@($"{totalValue:N2} kr")</td>
                                    <td class="data-cell">@($"{player.Capital:N2} kr")</td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (HasLoaded)
        {
            <div class="card mb-12" style="margin-bottom: var(--spacing-12); position: relative; z-index: 1;">
                <h2 class="headline-md mb-8">Portefølje Værdi Over Tid</h2>

                <div class="flex gap-4 mb-8" style="flex-wrap: wrap;">
                    <button class="@GetTimeRangeButtonClass("1d")" @onclick="@(async () => await SelectTimeRange("1d"))">1 dag</button>
                    <button class="@GetTimeRangeButtonClass("5d")" @onclick="@(async () => await SelectTimeRange("5d"))">5 dage</button>
                    <button class="@GetTimeRangeButtonClass("1m")" @onclick="@(async () => await SelectTimeRange("1m"))">1 måned</button>
                    <button class="@GetTimeRangeButtonClass("3m")" @onclick="@(async () => await SelectTimeRange("3m"))">3 måneder</button>
                    <button class="@GetTimeRangeButtonClass("1y")" @onclick="@(async () => await SelectTimeRange("1y"))">1 år</button>
                </div>

                <div style="height: 400px; overflow: hidden; position: relative;">
                    @if (Players.Any(p => p.ValuePoints?.Any() == true))
                    {
                        <ApexChart @ref="_chart" TItem="ValuePoint"
                                   Options="chartOptions">

                            @foreach (var player in Players.OrderByDescending(p => p.Email == Email))
                            {
                                @if (player.ValuePoints?.Any() == true)
                                {
                                    <ApexPointSeries TItem="ValuePoint"
                                                     Items="player.ValuePoints"
                                                     Name="@(player.Email == Email ? "Dig (Portefølje)" : player.Email)"
                                                     SeriesType="SeriesType.Area"
                                                     XValue="@(e => e.Date)"
                                                     YValue="@(e => e.Value)" />
                                }
                            }
                        </ApexChart>
                    }
                    else
                    {
                        <div style="text-align: center; padding: var(--spacing-8); color: rgba(214, 228, 249, 0.5); height: 100%; display: flex; align-items: center; justify-content: center;">
                            <p class="body-md">Ingen historik tilgængelig endnu</p>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card mt-10" style="position: relative; z-index: 2;">
            <div class="flex-between mb-8">
                <h2 class="headline-md">Din Beholdning</h2>
                <button class="btn btn-secondary" @onclick="async () => await AddTransaction()" style="background-color: var(--secondary); color: var(--on-secondary);">+ Tilføj Transaktion</button>
            </div>

            @if (CurrentPlayer?.Stocks?.Any() == true)
            {
                <div style="overflow-x: auto;">
                    <table class="design-table">
                        <thead>
                            <tr>
                                <th>Ticker</th>
                                <th>Antal</th>
                                <th>Værdi</th>
                                <th style="text-align: right;">Handling</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in CurrentPlayer.Stocks)
                            {
                                <tr class="surface-container-lowest">
                                    <td class="data-cell">@stock.Ticker</td>
                                    <td class="data-cell">@stock.Amount.ToString("N2")</td>
                                    <td class="data-cell text-secondary">@($"{stock.ValueInTargetCurrency:N2} {targetCurrency}")</td>
                                    <td style="text-align: right;">
                                        <button class="btn btn-tertiary" @onclick="async () => await AddTransaction(stock)">Sælg</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="body-md" style="text-align: center; padding: var(--spacing-12) 0; color: rgba(214, 228, 249, 0.5);">
                    Du har ikke købt aktier endnu. Klik "Tilføj Transaktion" for at komme i gang.
                </p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GameViewModel Value { get; set; }
    [Parameter, EditorRequired] public string Email { get; set; }

    [Inject] private IGameService _gameService { get; set; }
    [Inject] private IDialogService _dialogService { get; set; }
    [Inject] private PresentationService _presentation { get; set; }

    private ApexChart<ValuePoint> _chart = new();
    private string targetCurrency = "DKK";
    private ApexChartOptions<ValuePoint> chartOptions = new();
    private List<ParticipantViewModel> Players = [];
    private ParticipantViewModel CurrentPlayer = new();
    private bool HasLoaded;
    private string SelectedTimeRange = "5d";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task SetUpValues()
    {
        try
        {
            var allStocks = Players.SelectMany(x => x.Stocks ?? new List<StockViewModel>());
            foreach (var stock in allStocks)
            {
                stock.ValueInTargetCurrency = await _presentation.GetValueInTargetCurrency(stock);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up values: {ex.Message}");
        }
    }

    private void SetupChartOptions()
    {
        // 1. Farve-logik: Sørg for at din egen farve altid er først
        List<string> colors = new();
        string[] colorPalette = { "#bbc6e2", "#ffb4ab", "#a8dadc", "#f1d4b1", "#d7b8ff", "#ffccdd" };
        int colorIndex = 0;

        var sortedPlayers = Players.OrderByDescending(p => p.Email == Email).ToList();

        foreach (var player in sortedPlayers)
        {
            if (player.Email == Email) colors.Add("#7dffa2"); // Din grønne farve
            else
            {
                colors.Add(colorPalette[colorIndex % colorPalette.Length]);
                colorIndex++;
            }
        }

        chartOptions = new ApexChartOptions<ValuePoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Animations = new Animations { Enabled = true },
                Background = "transparent",
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Colors = colors,
            Fill = new Fill
            {
                Type = FillType.Gradient,
                Gradient = new FillGradient { OpacityFrom = 0.5, OpacityTo = 0.0 }
            },
            Yaxis = new List<YAxis> {
            new YAxis {
                // ForceNiceScale = true sammen med de andre herunder sikrer runde tal
                ForceNiceScale = true,
                DecimalsInFloat = 0,
                // Vi fjerner manuel Min/Max for at lade ApexCharts finde de "nærmeste" runde tal
                // Men vi sætter denne for at sikre, den ikke altid tvinger den ned til 0
                Labels = new YAxisLabels {
                    Style = new AxisLabelStyle {
                        Colors = new List<string> { "rgba(214, 228, 249, 0.6)" },
                        FontSize = "12px"
                    },
                    Formatter = @"value => Math.round(value).toLocaleString('da-DK') + ' kr'"
                }
            }
        },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = new List<string> { "rgba(214, 228, 249, 0.6)" } }
                }
            },
            // Grid Padding er "hemmeligheden" bag at undgå at top/bund bliver klippet
            Grid = new Grid
            {
                Padding = new Padding
                {
                    Top = 30,    // Giver masser af plads til toppen af kurven
                    Bottom = 30, // Giver plads i bunden
                    Left = 20,
                    Right = 20
                },
                BorderColor = "rgba(68, 71, 76, 0.1)"
            },
            Legend = new Legend
            {
                Show = true,
                Position = LegendPosition.Bottom,
                FontSize = "14px",
                Labels = new LegendLabels { Colors = "rgba(214, 228, 249, 0.6)" }
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Style = new TooltipStyle { FontFamily = "Inter, sans-serif" }
            }
        };
    }

    private async Task LoadData()
    {
        try
        {
            HasLoaded = false;
            Players = await _gameService.GetPlayers(Value.Id);
            var player = Players.FirstOrDefault(x => x.Email == Email);
            if (player == null) return;

            CurrentPlayer = player;
            await _presentation.Init(Players, Value.StartCapital);
            await SetUpValues();

            foreach (var p in Players)
            {
                if (p.ValuePoints == null) p.ValuePoints = new List<ValuePoint>();
            }

            await _presentation.LoadHistoricalData(GenerateDateRangeForTimespan(SelectedTimeRange));

            // Vi genberegner chart options nu hvor vi har data
            SetupChartOptions();
            await AfterUpdate();
            HasLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            HasLoaded = true;
        }
    }

    private async Task AddTransaction(StockViewModel? sellStock = null)
    {
        try
        {
            DialogParameters dialParams = new() { { "GameId", Value.Id }, { "Ticker", sellStock?.Ticker } };
            var dial = await _dialogService.ShowAsync<Dialogs.TransactionDialog>("Transaction", dialParams);
            var res = await dial.Result;
            if (!res.Canceled) await LoadData();
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private async Task SelectTimeRange(string timeRange)
    {
        SelectedTimeRange = timeRange;
        List<DateTime> dates = GenerateDateRangeForTimespan(SelectedTimeRange);
        await _presentation.LoadHistoricalData(dates);

        // Vigtigt: Genberegn skala når tidsinterval ændres
        SetupChartOptions();
        await AfterUpdate();
    }

    private async Task AfterUpdate()
    {
        StateHasChanged();
        if (_chart is not null) await _chart.UpdateSeriesAsync();
    }

    private List<DateTime> GenerateDateRangeForTimespan(string timeRange)
    {
        int daysBack = timeRange switch { "1d" => 1, "5d" => 5, "1m" => 30, "3m" => 90, "1y" => 365, _ => 5 };
        return Enumerable.Range(0, daysBack + 1).Select(i => DateTime.Now.AddDays(-i)).OrderBy(d => d).ToList();
    }

    private string GetTimeRangeButtonClass(string range) => $"btn {(SelectedTimeRange == range ? "btn-primary" : "btn-tertiary")}";
    private List<ParticipantViewModel> GetPlayersByTotalValue() => Players.OrderByDescending(p => GetPlayerTotalValue(p)).ToList();
    private decimal GetPlayerTotalValue(ParticipantViewModel player) => (decimal)player.Capital + player.Stocks.Sum(s => (decimal)s.ValueInTargetCurrency);
}