@namespace StockApp.Components

<div class="@CssClass">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Elevated { get; set; } = false;

    [Parameter]
    public string Layer { get; set; } = "low";

    [Parameter]
    public string Padding { get; set; } = "p-8";

    [Parameter]
    public string? CustomClass { get; set; }

    private string CssClass => $"card {(Elevated ? "card-elevated" : "")} {Padding} surface-container-{Layer} {CustomClass}".Trim();
}
