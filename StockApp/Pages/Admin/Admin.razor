@page "/admin"
@inject IGameService _gameService
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using StockApp.Models
@using StockApp.Services

<h3>Admin</h3>

<h4>Games</h4>
@foreach (GameViewModel game in Games)
{
    <MudGrid>
        <MudItem xs="10">@game.Name</MudItem>
        <MudItem xs="2"><MudButton OnClick="async ()=> await AddPlayer(game.Id)">Add Player</MudButton></MudItem>
    </MudGrid>
}


<MudDialog @bind-Visible="_visible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Edit rating
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="NewPlayerEmail" Label="Add player (email)" Variant="Variant.Outlined"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Class="px-10">Add</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Close" Class="px-10">Close</MudButton>

    </DialogActions>
</MudDialog>

<CreateGameComponent />

@code {
    private List<GameViewModel> Games = [];
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };
    private bool _visible;
    private string NewPlayerEmail = string.Empty;
    private string CurrentGameId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Games = await _gameService.GetGames();
    }
    private async Task Submit()
    {
        await _gameService.AddPlayerToGame(CurrentGameId, NewPlayerEmail);
        ResetDialog();
    }
    private void Close()
    {
        ResetDialog();
    }
    private async Task AddPlayer(string gameId)
    {
        CurrentGameId = gameId;
        _visible = true;

    }
    private void ResetDialog()
    {
        NewPlayerEmail = string.Empty;
        CurrentGameId = string.Empty;
        _visible = false;
    }
}
