@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using StockApp.Models
@using StockApp.Services
@using System.Security.Claims
@inject IGameService _gameService

@inject AuthenticationStateProvider provider
@attribute [Authorize]

<PageTitle>🚀 Aktiedysten</PageTitle>

<MudSelect @bind-Value="SelectedGame" ToStringFunc="x => x?.Name">
    @foreach (var game in playersGames)
    {
        <MudSelectItem Value="game" />
    }
</MudSelect>

@if (SelectedGame is not null)
{
    <Game Value="SelectedGame" Email="@email" />
}

@code {
    List<GameViewModel> playersGames = [];
    private GameViewModel? SelectedGame;
    private string email { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var state = await provider.GetAuthenticationStateAsync();
        email = state.User.Claims.First(x => x.Type == "email").Value;
        playersGames = await _gameService.GetPlayerGames();
        var runningGames = GetRunningGames(playersGames);
        if (runningGames.Count() == 1)
        {
            SelectedGame = runningGames.First();
        }
    }


    private IEnumerable<GameViewModel> GetRunningGames(List<GameViewModel> playersGames)
    {
        return playersGames.Where(x => x.EndDate > DateTime.Now);
    }
}




